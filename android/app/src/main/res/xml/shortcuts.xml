<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_chat"
        android:shortcutId="new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat_long"
        android:shortcutShortLabel="@string/shortcut_new_chat_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="app.deepchat.mobile://action?type=new"
            android:targetClass="app.deepchat.mobile.MainActivity"
            android:targetPackage="app.deepchat.mobile" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutId="voice_input"
        android:shortcutLongLabel="@string/shortcut_voice_long"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="app.deepchat.mobile://action?type=voice"
            android:targetClass="app.deepchat.mobile.MainActivity"
            android:targetPackage="app.deepchat.mobile" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutId="camera_input"
        android:shortcutLongLabel="@string/shortcut_camera_long"
        android:shortcutShortLabel="@string/shortcut_camera_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="app.deepchat.mobile://action?type=camera"
            android:targetClass="app.deepchat.mobile.MainActivity"
            android:targetPackage="app.deepchat.mobile" />
    </shortcut>
</shortcuts>
